# TrueFriend — environment template. Copy to .env and fill in real values.
# .env is gitignored; never commit real keys.

# ── LLM providers (P1.2 gateway) ──────────────────────────────
AZURE_OPENAI_API_KEY=your-azure-key
AZURE_OPENAI_ENDPOINT=https://your-deployment.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=o4-mini
GROQ_API_KEY=gsk-your-groq-key
GEMINI_API_KEY=your-gemini-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# ── Local embedding model (nomic via llama.cpp, 512-dim) ──────
LLAMA_EMBEDDING_MODEL_PATH=models/nomic-embed-text-v1.5.Q8_0.gguf

# ── Langfuse tracing (P1.3) ───────────────────────────────────
# The Langfuse instance is self-hosted by the owner at a separate location
# (owner decision 2026-07-17). This box is a client only.
LANGFUSE_HOST=https://your-langfuse-host.example.com
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
